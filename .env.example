# Copy this file to .env and fill in your own values.
# Never commit the real .env (it's gitignored).

# ── Anthropic (AI mindmap generation) ────────────────────────────────
# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenRouter (free-model fallback) ──────────────────────────────────
# Used ONLY when Anthropic fails (rate limit, outage, etc.) so map generation
# still works. Get a key at https://openrouter.ai/keys — no card required for
# free models. Every model tried is a $0 ":free" variant (see
# src/lib/openrouter.server.ts). If this key is unset, the fallback is simply
# skipped and the original Anthropic error is shown.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the free-model list (must stay ":free" or "openrouter/free")
# OPENROUTER_MODEL=google/gemma-3-27b-it:free

# ── Groq Whisper (high-accuracy voice Capture — FREE tier) ───────────
# Preferred STT for iPhone/Android: record audio → Whisper on Groq.
# Free tier (~2,000 audio requests/day). No credit card required.
# Get a key at https://console.groq.com/keys — set in Vercel + redeploy.
# If unset, Capture falls back to browser Web Speech API.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional model override (must remain a Groq Whisper model):
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Public app URL (OAuth redirects + Capacitor) ─────────────────────
VITE_PUBLIC_APP_URL=https://notiolive.com

# ── RevenueCat (store IAP — native apps only) ─────────────────────────
# Public SDK keys from RevenueCat → Project → API keys (build-time VITE_).
# VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxx
# VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx
# Optional webhook auth for /api/webhooks/revenuecat
# REVENUECAT_WEBHOOK_SECRET=whsec_xxxxxxxx

# ── Stripe (Pro subscription + landing plans) ────────────────────────
# dashboard.stripe.com → Developers → API keys (secret key, test or live)
STRIPE_SECRET_KEY=REPLACE_ME_STRIPE_SECRET_KEY
# Default monthly Price ID (used by in-app /pricing + landing Pro Monthly)
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
# Dedicated IDs for landing tiers (set all three for full checkout):
STRIPE_PRICE_ID_MONTHLY=price_xxx   # $12/mo recurring
STRIPE_PRICE_ID_ANNUAL=price_xxx    # $48/yr recurring
STRIPE_PRICE_ID_LIFETIME=price_xxx  # $79 one-time (Founders)

# ── Supabase ─────────────────────────────────────────────────────────
# From your project at https://supabase.com → Project Settings → API.
# The "publishable" / anon key is safe for the browser. The service-role
# key is SECRET (server only) — never expose it to the client.

# Server-side (no VITE_ prefix)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_PROJECT_ID=YOUR-PROJECT-ref

# Client-side (VITE_ prefix — inlined into the browser bundle at build time)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-ref

# Optional: direct mp4/webm/mov URL for the landing walkthrough custom player.
# If unset, the app tries /demo-walkthrough.mp4 then /demo-walkthrough.mov in public/.
# If that fails, it falls back to the Google Drive iframe.
# VITE_DEMO_VIDEO_URL=https://your-cdn.example.com/notio-walkthrough.mp4

# ── Email Reminders (Resend) ──────────────────────────────────────────
# From https://resend.com → API Keys
# Used for scheduling task reminder emails (optional, reminders skipped if not set)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cron Job Security (Vercel) ────────────────────────────────────────
# REQUIRED in production: secures the /api/cron/reminders endpoint.
# The endpoint now FAILS CLOSED - if CRON_SECRET is unset it returns 401,
# so an attacker cannot trigger or suppress reminder emails.
# Generate one with:  openssl rand -hex 32
# Set the SAME value in Vercel project env vars (Vercel Cron sends it automatically).
# Also secures /api/cron/weekly-report (Feature 2) and
# /api/cron/google-calendar-sync (Google → Notio poll).
CRON_SECRET=your-secret-token-here

# ── Feature Flags (CEO-spec: 3 Wins / Weekly Reflection / Cross-Map RAG) ──
# Each flag has a bare form (read at runtime by the server) and a VITE_-prefixed
# form (inlined into the client bundle at build time). Set BOTH when enabling
# in production. Truthy values: "1", "true", "yes", "on" (case-insensitive).
# Anything else (including unset) falls back to the default shown below.

# Feature 1 — End-of-Day "3 Wins" Report (default ON).
FEATURE_DAILY_WINS=1
VITE_FEATURE_DAILY_WINS=1

# Feature 2 — Weekly Reflection Report (default ON). The cron handler also
# gates itself on this flag, returning 200 "feature disabled" when off.
FEATURE_WEEKLY_REFLECTION=1
VITE_FEATURE_WEEKLY_REFLECTION=1

# Feature 3 — Cross-Map RAG (default OFF). Requires OPENAI_API_KEY to be useful.
# When off, weekly reports generate from wins + task stats only (no RAG retrieval).
FEATURE_CROSS_MAP_RAG=0
VITE_FEATURE_CROSS_MAP_RAG=0

# Google Calendar sync (default OFF). Requires Google Cloud OAuth web client +
# Calendar API. See GOOGLE_CALENDAR_SETUP.md. Set BOTH bare + VITE_ flags.
FEATURE_GOOGLE_CALENDAR=1
VITE_FEATURE_GOOGLE_CALENDAR=1

# ── CEO handoff flags (default OFF until staging migrations + gates pass) ──
# Set BOTH server FEATURE_* and build-time VITE_FEATURE_* to the same value.
# See .env.handoff.example and HANDOFF_SETUP_ROLLBACK.md.
FEATURE_WORKFLOW=0
VITE_FEATURE_WORKFLOW=0
FEATURE_DOLPHIN_XP=0
VITE_FEATURE_DOLPHIN_XP=0
FEATURE_NATIVE_WIDGETS=0
VITE_FEATURE_NATIVE_WIDGETS=0
FEATURE_CANVAS_PILOT=0
VITE_FEATURE_CANVAS_PILOT=0
FEATURE_CANVAS_CONNECT=0
VITE_FEATURE_CANVAS_CONNECT=0
FEATURE_CANVAS_IMPORT=0
FEATURE_CANVAS_DISPATCH=0
# Private Canvas MCP broker (never put a student token here)
CANVAS_MCP_URL=
CANVAS_MCP_SERVICE_TOKEN=

# Optional: dedicated secret for encrypting Canvas tokens at rest (defaults to hashing service role).
CANVAS_TOKEN_SECRET=

# ── Google Calendar OAuth (optional — FEATURE_GOOGLE_CALENDAR) ────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client.
# Enable "Google Calendar API". Redirect URI must match exactly:
#   https://YOUR-DOMAIN/api/integrations/google-calendar/callback
#   http://localhost:8080/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/integrations/google-calendar/callback

# ── OpenAI (Cross-Map RAG embeddings — Feature 3, OPTIONAL) ───────────
# Used ONLY when FEATURE_CROSS_MAP_RAG=1. Anthropic has no embeddings API, so
# we use OpenAI's text-embedding-3-small (1536 dims) via direct fetch (no SDK).
# If unset, RAG silently degrades — weekly reports still generate from wins +
# task stats. Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
